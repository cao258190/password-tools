# 复制为 .env.docker，或运行 ./deploy.sh 自动生成。
# 如果部署在真实域名后面，请将 CORS_ORIGIN 设置为前端访问源。
CORS_ORIGIN=http://localhost:3910

# 仅在站点通过 HTTPS 访问时设置 COOKIE_SECURE=true。
COOKIE_SECURE=false

# 生产环境请使用足够长的随机值。
JWT_SECRET=change-me-with-a-long-random-string
SERVER_CRYPTO_SECRET=change-me-with-another-long-random-string

# 首次初始化时创建的默认管理员。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploy

# 新用户注册默认关闭。管理员可在应用内修改。
REGISTRATION_ENABLED=false

# 代码仓库版本检测。管理员设置页会对比此仓库和引用。
GITHUB_OWNER=cao258190
GITHUB_REPO=password-tools
UPDATE_CHECK_REF=master

# 页面在线更新仅管理员可用，且默认关闭。
# 仅在准备好可信的服务端更新命令后再同时设置这两个值。
WEB_UPDATE_ENABLED=false
UPDATE_COMMAND=
