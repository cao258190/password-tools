# Copy to .env.docker or run ./deploy.sh to generate it automatically.
# If you deploy behind a real domain, set CORS_ORIGIN to that frontend origin.
CORS_ORIGIN=http://localhost:3910

# Set COOKIE_SECURE=true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Use long random values in production.
JWT_SECRET=change-me-with-a-long-random-string
SERVER_CRYPTO_SECRET=change-me-with-another-long-random-string
