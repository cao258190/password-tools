# Copy to .env.docker or run ./deploy.sh to generate it automatically.
# If you deploy behind a real domain, set CORS_ORIGIN to that frontend origin.
CORS_ORIGIN=http://localhost:3910

# Set COOKIE_SECURE=true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Use long random values in production.
JWT_SECRET=change-me-with-a-long-random-string
SERVER_CRYPTO_SECRET=change-me-with-another-long-random-string

# Default administrator created on first initialization.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploy

# New user registration is disabled by default. Admins can change it in the app.
REGISTRATION_ENABLED=false

# GitHub version detection. The admin settings page compares this repo/ref.
GITHUB_OWNER=cao258190
GITHUB_REPO=password-tools
UPDATE_CHECK_REF=master

# Web updates are admin-only and disabled by default.
# Set both values only after you have prepared a trusted server-side update command.
WEB_UPDATE_ENABLED=false
UPDATE_COMMAND=
